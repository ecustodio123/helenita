# Public frontend configuration only. Never use a service_role or secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Existing store_id. Kafka Commerce 0.3.0 requires storeId, not store_slug.
VITE_STORE_ID=
# International WhatsApp number, 8–15 digits. +, spaces and hyphens are normalized.
VITE_WHATSAPP_PHONE=
# Optional display name and existing public image bucket.
VITE_STORE_NAME=Helenita
VITE_PRODUCT_IMAGE_BUCKET=product-images
